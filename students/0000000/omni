def cmd_del(args: list[str]) -> None:
    if len(args) < 1:
        die("사용법: omni del <slot|학번|s학번>")
    data = load()
    s = find_student(data, args[0])
    if s is None:
        die(f"학생을 찾을 수 없습니다: {args[0]}")
    if s["slot"] == ADMIN_SLOT:
        die("관리자 계정은 삭제할 수 없습니다")

    login = login_id_of(s)
    slot = s["slot"]
    old_no = s.get("id")

    if container_running(slot):
        sync_db_account(slot, login, "", old_login_id=login, create_new=False)
        run(f"docker exec {container(slot)} userdel -r {login}", check=False)
    delete_pipe(login)

    s["name"] = ""
    s["id"] = ""
    s["login_id"] = ""
    s["password"] = ""
    save(data)
    print(f"✅ 슬롯 초기화: slot {slot}, 이전 로그인 {login}")

    if old_no:
        print(f"ℹ️  NPM 도메인({old_no}.{DOMAIN_SUFFIX})은 자동 삭제하지 않았습니다.")


def cmd_ps(_args: list[str]) -> None:
    result = run("docker ps --filter 'name=student' --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'", check=False)
    print(result.stdout, end="")


