def cmd_restartappall(_args: list[str]) -> None:
    """모든 학생 컨테이너의 app.py를 재시작"""
    print("[omni] 모든 학생 app.py 재시작...")
    success = failed = skipped = 0
    for student in active_students():
        slot = student["slot"]
        if not container_running(slot):
            skipped += 1
            print_result_header(student)
            print("SKIP: 컨테이너 중지 상태")
            continue
        # app.py 종료 및 재시작
        result = exec_in_student(student, "pkill -f app.py; sleep 1; nohup python3 ~/app.py > ~/app.log 2>&1 &")
        print_result_header(student)
        if result.returncode == 0:
            print("app.py 재시작 완료")
            success += 1
        else:
            print("app.py 재시작 실패")
            failed += 1
    print(f"요약: 성공 {success}, 실패 {failed}, 건너뜀 {skipped}")
    if failed:
        sys.exit(1)

def cmd_push(args: list[str]) -> None:
    """관리자 파일을 모든 학생 홈에 일괄 배포"""
    if len(args) != 1:
        die("사용법: omni push <file>")
    src = os.path.abspath(args[0])
    if not os.path.isfile(src):
        die(f"파일이 존재하지 않음: {src}")
    for student in active_students():
        slot = student["slot"]
        if not container_running(slot):
            print(f"{login_id_of(student)}: SKIP (컨테이너 중지)")
            continue
        dst = f"/home/{login_id_of(student)}/{os.path.basename(src)}"
        # docker cp로 파일 복사
        run(f"docker cp {shlex.quote(src)} {container(slot)}:{shlex.quote(dst)}", check=False)
        print(f"{login_id_of(student)}: {dst} 배포 완료")

def cmd_pushdir(args: list[str]) -> None:
    """관리자 디렉토리를 모든 학생 홈에 일괄 배포"""
    if len(args) != 1:
        die("사용법: omni pushdir <dir>")
    src = os.path.abspath(args[0])
    if not os.path.isdir(src):
        die(f"디렉토리가 존재하지 않음: {src}")
    for student in active_students():
        slot = student["slot"]
        if not container_running(slot):
            print(f"{login_id_of(student)}: SKIP (컨테이너 중지)")
            continue
        dst = f"/home/{login_id_of(student)}/{os.path.basename(src)}"
        # 디렉토리 tar로 복사
        tar_cmd = f"tar -C {shlex.quote(os.path.dirname(src))} -cf - {shlex.quote(os.path.basename(src))}"
        docker_cmd = f"docker exec -i {container(slot)} tar -C /home/{login_id_of(student)} -xf -"
        with os.popen(f"{tar_cmd} | {docker_cmd}") as p:
            p.read()
        print(f"{login_id_of(student)}: {dst} 디렉토리 배포 완료")

def cmd_collect(args: list[str]) -> None:
    """모든 학생의 파일/경로를 한 디렉토리에 수거"""
    if len(args) != 1:
        die("사용법: omni collect <path>")
    path = args[0]
    outdir = os.path.abspath(f"collect_{datetime.now().strftime('%Y%m%d_%H%M%S')}")
    os.makedirs(outdir, exist_ok=True)
    for student in active_students():
        slot = student["slot"]
        if not container_running(slot):
            print(f"{login_id_of(student)}: SKIP (컨테이너 중지)")
            continue
        src = f"/home/{login_id_of(student)}/{path}"
        dst = os.path.join(outdir, f"{login_id_of(student)}_{os.path.basename(path)}")
        # 파일/디렉토리 복사 (디렉토리는 zip)
        r = run(f"docker exec {container(slot)} test -d {shlex.quote(src)}", check=False)
        if r.returncode == 0:
            # 디렉토리: zip으로 압축 후 복사
            zipname = f"/tmp/{login_id_of(student)}_{os.path.basename(path)}.zip"
            run(f"docker exec {container(slot)} zip -r {shlex.quote(zipname)} {shlex.quote(src)}", check=False)
            run(f"docker cp {container(slot)}:{zipname} {shlex.quote(dst)}.zip", check=False)
            run(f"docker exec {container(slot)} rm -f {shlex.quote(zipname)}", check=False)
            print(f"{login_id_of(student)}: DIR -> {dst}.zip")
        else:
            # 파일: 직접 복사
            run(f"docker cp {container(slot)}:{shlex.quote(src)} {shlex.quote(dst)}", check=False)
            print(f"{login_id_of(student)}: FILE -> {dst}")

