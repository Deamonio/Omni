def cmd_sshwho(args: list[str]) -> None:
    """현재 SSH 접속 세션 조회.

    기본값은 접속 중인 세션만 표시하고,
    --all 옵션을 주면 모든 슬롯 상태를 함께 표시한다.
    """
    show_all = "--all" in args
    fmt = "{:>4}  {:<10}  {:<16}  {:<10}  {}"
    print(fmt.format("슬롯", "로그인ID", "원격IP", "TTY", "접속시각"))
    print("-" * 72)

    rows = 0
    for student in active_students(include_admin=True):
        slot = student["slot"]
        login_id = "omni" if slot == ADMIN_SLOT else login_id_of(student)
        rt_container = runtime_container(slot)

        if not rt_container:
            if show_all:
                print(f"{slot:>4}  {login_id:<10}  {'-':<16}  {'-':<10}  컨테이너 중지")
                rows += 1
            continue

        who = run(f"docker exec {rt_container} sh -lc \"who\"", check=False)
        if who.returncode != 0:
            if show_all:
                print(f"{slot:>4}  {login_id:<10}  {'-':<16}  {'-':<10}  who 조회 실패")
                rows += 1
            continue

        matched = []
        for line in who.stdout.splitlines():
            line = line.strip()
            if not line:
                continue
            parts = line.split()
            if not parts:
                continue
            user = parts[0]
            if user != login_id:
                continue

            tty = parts[1] if len(parts) > 1 else "-"
            login_at = " ".join(parts[2:4]) if len(parts) >= 4 else "-"
            remote_ip = "-"
            if len(parts) >= 5:
                remote_ip = " ".join(parts[4:]).strip("()") or "-"
            matched.append((remote_ip, tty, login_at))

        if not matched:
            # 일부 환경에서는 who/w가 비어도 sshd-session 프로세스는 존재한다.
            # 이 경우 ps 기반으로 로그인 세션을 보완 탐지한다.
            ps = run(
                f"docker exec {rt_container} sh -lc \"ps -eo pid=,user=,tty=,lstart=,cmd= | grep 'sshd-session: ' | grep '@pts/' | grep -v grep\"",
                check=False,
            )
            if ps.returncode == 0:
                for line in ps.stdout.splitlines():
                    parts = line.split()
                    if len(parts) < 9:
                        continue
                    user = parts[1]
                    tty = parts[2]
                    if user != login_id:
                        continue
                    login_at = " ".join(parts[3:8])
                    cmdline = " ".join(parts[8:])
                    m = re.search(r"@([A-Za-z0-9._/:-]+)", cmdline)
                    if m:
                        tty = m.group(1)
                    matched.append(("-", tty, login_at))

        if matched:
            for remote_ip, tty, login_at in matched:
                print(f"{slot:>4}  {login_id:<10}  {remote_ip:<16}  {tty:<10}  {login_at}")
                rows += 1
        elif show_all:
            print(f"{slot:>4}  {login_id:<10}  {'-':<16}  {'-':<10}  접속 없음")
            rows += 1

    if rows == 0:
        print("현재 SSH 접속 중인 세션이 없습니다.")


