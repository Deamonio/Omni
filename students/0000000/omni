def cmd_execall(args: list[str]) -> None:
    if not args:
        die("사용법: omni execall <command...>")
    command_text = shell_join(args)
    success = failed = skipped = 0
    for student in active_students():
        slot = student["slot"]
        if not container_running(slot):
            skipped += 1
            print_result_header(student)
            print("SKIP: 컨테이너 중지 상태")
            continue

        result = exec_in_student(student, command_text)
        print_result_header(student)
        if result.stdout:
            print(result.stdout, end="" if result.stdout.endswith("\n") else "\n")
        if result.stderr:
            print(result.stderr, end="" if result.stderr.endswith("\n") else "\n", file=sys.stderr)
        print(f"exit code: {result.returncode}")
        if result.returncode == 0:
            success += 1
        else:
            failed += 1

    print("=" * 72)
    print(f"요약: 성공 {success}, 실패 {failed}, 건너뜀 {skipped}")
    if failed:
        sys.exit(1)


